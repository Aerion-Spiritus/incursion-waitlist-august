{
  "version": "2.0.0",
  "options": {
    "env": {
      "DATABASE_ENGINE": "mysql",
      "DATABASE_URL": "mysql://<username>:<password>@localhost/imperium_incursions?ssl-mode=disabled"
    },
    "cwd": "${workspaceFolder}/backend"
  },
  "tasks": [
    {
      "label": "Build API",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--no-default-features",
        "--features=mysql"
      ]
    }
  ]
}
